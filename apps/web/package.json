{
  "name": "@geo-coach/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/server/db/migrate.ts",
    "db:seed": "tsx src/lib/server/db/seed.ts",
    "db:rebuild-derived": "tsx src/lib/server/db/rebuild-derived.ts"
  },
  "dependencies": {
    "@geo-coach/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "arctic": "^3.6.0",
    "drizzle-orm": "^0.41.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.14.0",
    "drizzle-kit": "^0.30.6",
    "esbuild": "^0.28.2",
    "svelte": "^5.25.0",
    "svelte-check": "^4.1.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.0",
    "vitest": "^3.1.4"
  }
}
